<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Leistung bearbeiten" : "Leistung hinzufügen")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="Model.Description"
                          Label="Beschreibung *"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Beschreibung ist erforderlich."
                          MaxLength="500"
                          Class="mb-3" />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="Model.Hours"
                                     Label="Stunden *"
                                     Variant="Variant.Outlined"
                                     Min="0.01m"
                                     Max="9999.99m"
                                     Format="F2"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="Model.HourlyRateAmount"
                                     Label="Stundensatz (€) *"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Format="F2"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int"
                               Value="@Model.TaxRatePercent"
                               ValueChanged="@((int v) => Model.TaxRatePercent = v)"
                               Label="Steuersatz"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="0">0 % (steuerfrei)</MudSelectItem>
                        <MudSelectItem Value="10">10 % (ermäßigt)</MudSelectItem>
                        <MudSelectItem Value="20">20 % (Standard)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (Model.Hours > 0 && Model.HourlyRateAmount >= 0)
            {
                var net = Math.Round(Model.Hours * Model.HourlyRateAmount, 2);
                var tax = Math.Round(net * Model.TaxRatePercent / 100m, 2);
                var gross = net + tax;

                <MudPaper Class="pa-3 mt-4" Elevation="0" Style="background:#f5f5f5">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Vorschau</MudText>
                    <MudGrid Spacing="1" Class="mt-1">
                        <MudItem xs="6"><MudText Typo="Typo.body2">Netto</MudText></MudItem>
                        <MudItem xs="6"><MudText Typo="Typo.body2" Align="Align.Right">@net.ToString("F2") €</MudText></MudItem>
                        <MudItem xs="6"><MudText Typo="Typo.body2">MwSt. (@Model.TaxRatePercent %)</MudText></MudItem>
                        <MudItem xs="6"><MudText Typo="Typo.body2" Align="Align.Right">@tax.ToString("F2") €</MudText></MudItem>
                        <MudItem xs="6"><MudText Typo="Typo.body2"><b>Brutto</b></MudText></MudItem>
                        <MudItem xs="6"><MudText Typo="Typo.body2" Align="Align.Right"><b>@gross.ToString("F2") €</b></MudText></MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            @(IsEdit ? "Speichern" : "Hinzufügen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ServiceItemFormModel Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm _form = null!;
    private bool _isValid;

    private async Task Submit()
    {
        await _form.Validate();
        if (!_isValid) return;
        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed class ServiceItemFormModel
    {
        public string Description { get; set; } = string.Empty;
        public decimal Hours { get; set; } = 1m;
        public decimal HourlyRateAmount { get; set; } = 0m;
        public int TaxRatePercent { get; set; } = 20;
    }
}
